PORT=3002
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Core 를 호출하는 내부 서비스(BE)가 x-api-key 헤더로 제시할 키.
# 비워 두면 개발 편의를 위해 인증을 건너뜁니다. 운영에서는 필수입니다.
SERVICE_API_KEY=

# 허용 오리진 (쉼표 구분)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ---------------------------------------------------------------------------
# Oracle Hospitality Integration Platform (OHIP)
# ---------------------------------------------------------------------------
OHIP_BASE_URL=https://api.oracle-hospitality.example/
OHIP_APP_KEY=
OHIP_CLIENT_ID=
OHIP_CLIENT_SECRET=
OHIP_USERNAME=
OHIP_PASSWORD=
OHIP_HOTEL_ID=
OHIP_TOKEN_REFRESH_SKEW_SECONDS=60
OHIP_REQUEST_TIMEOUT_MS=15000
